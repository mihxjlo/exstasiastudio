# Copy to .env and fill in real values before running the backend.
# Spring Boot reads these as environment variables.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/exstasia
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT — must be at least 32 characters (256 bits) for HS256
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# Seeded admin account (used only on first startup if no admin exists)
ADMIN_EMAIL=admin@exstasia.com
ADMIN_PASSWORD=your_admin_password_here

# File storage (Docker volume mount path inside the container)
UPLOADS_DIR=/uploads

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
